# 複製成 .env.local（本機）或填到主機的環境變數設定頁。
# 「公開」= 名稱以 NEXT_PUBLIC_ 開頭，會出現在瀏覽器裡，不能放秘密。

# ---- 網站 ----
NEXT_PUBLIC_SITE_URL=https://mybooklet.party
# 隨機長字串，至少 32 字元，用來簽發登入憑證
SESSION_SECRET=
# 隨機長字串，GitHub Actions 定時掃描呼叫 /api/cron/mint 時使用
CRON_SECRET=

# 營運後台密碼（/admin），至少 12 個字元
ADMIN_PASSWORD=

# ---- 節目單頁面圖片儲存（Vercel Blob）----
# Vercel 專案 → Storage → 建立 Blob store 後自動加入；本機開發可留空（改存在 web/.data/）
BLOB_READ_WRITE_TOKEN=

# ---- 資料庫（PostgreSQL，例如 Supabase 或 Neon 給的連線字串）----
DATABASE_URL=

# ---- LINE ----
# LINE Login channel 的 Channel ID
LINE_LOGIN_CHANNEL_ID=
# LIFF app 的 LIFF ID（公開）
NEXT_PUBLIC_LIFF_ID=
# Messaging API channel 的 Channel access token（長期）
LINE_MESSAGING_ACCESS_TOKEN=

# ---- Google 登入 ----
# Google Cloud OAuth 用戶端 ID（公開）
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ---- Email 通知（Resend）----
RESEND_API_KEY=
EMAIL_FROM=吾冊 My Booklet <hello@mybooklet.party>

# ---- 區塊鏈（第 0 階段：Kaia 測試網 Kairos）----
KAIA_RPC_URL=https://public-en-kairos.node.kaia.io
KAIA_CHAIN_ID=1001
NEXT_PUBLIC_EXPLORER_URL=https://kairos.kaiascan.io
# 合約部署後取得
BOOKLET_CONTRACT_ADDRESS=
# npm run keys:generate 產生
WALLET_XPUB=
MINTER_PRIVATE_KEY=
CURATOR_PRIVATE_KEY=
